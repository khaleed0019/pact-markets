# Deployment (server-side only — never commit the real value, never expose in the browser)
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
DEPLOYER_PRIVATE_KEY=

# Optional: only needed to run `npx hardhat verify`. Free from etherscan.io (not
# monadscan.com — Monadscan speaks Etherscan's unified v2 API, one key across chains).
ETHERSCAN_API_KEY=

# AI Intelligence Layer (server-side only, read in app/api/intelligence/*/route.ts).
# Uses Gemini's free tier — get a key at https://aistudio.google.com/apikey.
# Optional: every panel that uses this fails quiet and honest ("not configured") rather
# than faking a result when it's unset — the app is fully functional without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Frontend — filled in automatically by scripts/deploy.ts after a real deployment
NEXT_PUBLIC_PACT_REGISTRY_ADDRESS=
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Confirmed against docs.monad.xyz/tooling-and-infra/block-explorers — Monadscan
# (Etherscan-powered) and MonadVision are both officially supported; Monadscan is used
# here for its familiar Etherscan-style verified-source view.
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadscan.com
